{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "moduleResolution": "bundler",
    "module": "ES2022",
    "strict": false,
    "skipLibCheck": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/**/*", "test/**/*"],
  // imageMetadata.test.ts imports the vendored CLI, which does not satisfy this
  // program's compiler options (it has its own tsconfig). Excluded from the
  // typecheck program only; vitest still runs it.
  "exclude": ["node_modules", "dist", "spike", "test/unit/imageMetadata.test.ts"]
}
